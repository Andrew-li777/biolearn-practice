process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_ALIGN$'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}bowtie2_rrna" }, mode:'copy', pattern:'*.log'], [path:{ params.save_non_ribo_reads ? "${params.outdir}/${task.ext.publish_prefix}bowtie2_rrna" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_non_ribo_reads ? filename : null }]]
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_ALIGN_PE$'.ext.args = '--very-sensitive-local'
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_ALIGN_PE$'.ext.prefix = { "${meta.id}.bowtie2_rrna" }
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_ALIGN_PE$'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}bowtie2_rrna" }, mode:'copy', pattern:'*.log'], [path:{ params.save_non_ribo_reads ? "${params.outdir}/${task.ext.publish_prefix}bowtie2_rrna" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_non_ribo_reads ? filename : null }]]
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SAMTOOLS_VIEW_BOWTIE2'.ext.prefix = { "${meta.id}.bowtie2_unmapped" }
