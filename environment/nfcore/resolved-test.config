process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:RIBODETECTOR'.ext.args = '-e rrna'
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:RIBODETECTOR'.cpus = 1
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:RIBODETECTOR'.accelerator = { params.use_gpu_ribodetector ? 1 : null }
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:RIBODETECTOR'.containerOptions = { params.use_gpu_ribodetector ? (params.gpu_container_options ?: (workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '--gpus all')) : null }
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:RIBODETECTOR'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}ribodetector" }, mode:'copy', pattern:'*.log'], [path:{ params.save_non_ribo_reads ? "${params.outdir}/${task.ext.publish_prefix}ribodetector" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_non_ribo_reads ? filename : null }]]
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_BUILD'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}bowtie2_rrna/index" }, mode:'copy', saveAs:{ filename -> params.save_reference ? filename : null }]
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:BOWTIE2_ALIGN$'.ext.args = '--very-sensitive-local'
