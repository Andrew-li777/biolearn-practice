            '--sorted',
            meta.strandedness == 'forward' ? '-p strand-specific-forward' :
                meta.strandedness == 'reverse' ? '-p strand-specific-reverse' :
                '-p non-strand-specific'
        ].join(' ') }
process.'withName:QUALIMAP_RNASEQ'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/qualimap" }, mode:'copy']
process.'withName:DUPRADAR'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/dupradar/scatter_plot" }, mode:'copy', pattern:'*Dens.pdf'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/dupradar/box_plot" }, mode:'copy', pattern:'*Boxplot.pdf'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/dupradar/histogram" }, mode:'copy', pattern:'*Hist.pdf'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/dupradar/gene_data" }, mode:'copy', pattern:'*Matrix.txt'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/dupradar/intercepts_slope" }, mode:'copy', pattern:'*slope.txt']]
process.'withName:PRESEQ_LCEXTRAP'.ext.args = '-verbose -bam -seed 1 -seg_len 100000000'
process.'withName:PRESEQ_LCEXTRAP'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/preseq" }, mode:'copy', pattern:'*.txt'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/preseq/log" }, mode:'copy', pattern:'*.log']]
process.'withName:RUSTQC'.ext.args = {
            def biotype_attr = params.gencode ? "gene_type" : (params.featurecounts_group_type ?: '')
            def strand_arg = meta.strandedness ? "--stranded ${meta.strandedness}" : ''
            [
                strand_arg,
                biotype_attr ? "--biotype-attribute ${biotype_attr}" : '',
                '--preseq-seed 1 --preseq-seg-len 100000000',
                '--tin-seed 1 --junction-saturation-seed 1',
                // UMI dedup removes duplicate reads, so RustQC's duplicate-marking check doesn't apply
                params.with_umi ? '--skip-dup-check' : '',
            ].join(' ').trim()
        }
process.'withName:RUSTQC'.publishDir = [path:{ "${params.outdir}/${params.aligner}/rustqc" }, mode:'copy', saveAs:{ filename ->
                // Strip sample prefix dir: SAMPLE/tool/file -> tool/file
                def stripped = filename.replaceFirst(/^[^\/]+\//, '')
                def base = stripped.tokenize('/').last()

                // Qualimap filenames (qualimapReport.html, rnaseq_qc_results.txt) are
                // not sample-prefixed, so re-insert the sample name as a subdirectory
                // to prevent collisions across samples.
                if (stripped.startsWith('qualimap/')) {
                    def sample = filename.split('/')[0]
                    return stripped.replaceFirst(/^qualimap\//, "qualimap/${sample}/")
                }

                // featurecounts: publish the biotype summary under the default
                // pipeline's name (*.featureCounts.tsv.summary) and suppress
                // the gene-level summary so published outputs are unchanged.
                if (stripped.startsWith('featurecounts/')) {
                    if (base.endsWith('.featureCounts.biotype.tsv.summary'))
                        return "featurecounts/${base.replace('.biotype.tsv.summary', '.tsv.summary')}"
                    if (base.endsWith('.featureCounts.tsv.summary'))
                        return null
                    return "featurecounts/${base}"
                }

                // samtools/ -> samtools_stats/
                if (stripped.startsWith('samtools/')) {
                    return "samtools_stats/${base}"
                }

                // dupradar: route into file-type subdirs
                if (stripped.startsWith('dupradar/')) {
                    if (base.contains('Boxplot'))        return "dupradar/box_plot/${base}"
                    if (base.contains('ExpDens') && !base.contains('Curve_mqc'))
                                                         return "dupradar/scatter_plot/${base}"
                    if (base.contains('expressionHist')) return "dupradar/histogram/${base}"
                    if (base.contains('dupMatrix'))      return "dupradar/gene_data/${base}"
                    if (base.contains('intercept_slope')) return "dupradar/intercepts_slope/${base}"
                    return "dupradar/${base}"
                }

                // RSeQC tools with file-type subdirs
                if (stripped.startsWith('rseqc/')) {
                    def rseqcPath = stripped.replaceFirst(/^rseqc\//, '')
                    def tool = rseqcPath.tokenize('/')[0]

                    if (tool in ['junction_annotation', 'junction_saturation', 'inner_distance', 'read_duplication']) {
                        if (base.endsWith('.r'))         return "rseqc/${tool}/rscript/${base}"
                        if (base.endsWith('.png') || base.endsWith('.svg'))
                                                         return "rseqc/${tool}/plot/${base}"
                        if (base.endsWith('.xls'))        return "rseqc/${tool}/xls/${base}"
                        if (base.endsWith('.bed'))        return "rseqc/${tool}/bed/${base}"
                        if (base.endsWith('.junction_annotation.log'))
                                                         return "rseqc/${tool}/log/${base}"
                        if (base.endsWith('.txt'))        return "rseqc/${tool}/txt/${base}"
                    }
                    return stripped
                }

                return stripped
            }]
process.'withName:KRAKEN2'.ext.args = '--confidence 0.05 --minimum-hit-groups 3'
process.'withName:KRAKEN2'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/contaminants/kraken2/kraken_reports" }, mode:'copy']
