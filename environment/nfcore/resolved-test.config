process.'withName:.*:FASTQ_FASTQC_UMITOOLS_TRIMGALORE:TRIMGALORE'.ext.args = {
            // Initialize the map with preconfigured values
            def preset_args_map = ["--fastqc_args": "'-t ${task.cpus}'"]

            // Parse extra args if provided
            def extra_args_map = [:]
            if (params.extra_trimgalore_args) {
                params.extra_trimgalore_args.split("\\s(?=--)").each { arg ->
                    def parts = arg.trim().split(/\s+/, 2)
                    extra_args_map[parts.first()] = parts.last()
                }
            }

            // Consolidate the arguments (extra args override preset)
            def final_args_map = preset_args_map + extra_args_map

            // Convert the map back to a single string
            final_args_map.collect { key, value -> "${key} ${value}" }.join(' ').trim()
        }
