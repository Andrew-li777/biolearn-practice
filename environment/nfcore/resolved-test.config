process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SAMTOOLS_FASTQ_BOWTIE2'.ext.prefix = { "${meta.id}.bowtie2_filtered" }
process.'withName:.*:FASTQ_QC_TRIM_FILTER_SETSTRANDEDNESS:.*:SAMTOOLS_FASTQ_BOWTIE2'.publishDir = [enabled:false]
