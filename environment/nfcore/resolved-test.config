process.'withName:DESEQ2_QC_(BAM_SALMON|RSEM)'.ext.args2 = { params.aligner }
process.'withName:DESEQ2_QC_(BAM_SALMON|RSEM)'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/deseq2_qc" }, mode:'copy', pattern:'*{RData,pca.vals.txt,plots.pdf,sample.dists.txt,size_factors,log}']
process.'withName:.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:(CUSTOM_TX2GENE|TXIMETA_TXIMPORT)'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" }, mode:'copy', saveAs:{ filename ->
                if (filename.equals('versions.yml')) return null
                if (params.skip_quantification_merge && filename.endsWith('gene_counts_length_scaled.tsv')) return null
                filename
            }]
process.'withName:.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:TXIMETA_TXIMPORT'.ext.prefix = { meta.id == 'all_samples' ? "${quant_type}.merged" : meta.id }
process.'withName:.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_.*'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" }, mode:'copy', saveAs:{ filename -> filename.equals('versions.yml') || filename.endsWith('.log') ? null : filename }]
process.'withName:.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_GENE_UNIFIED'.ext.prefix = { "rsem.merged.gene" }
process.'withName:.*:QUANTIFY_RSEM:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_TRANSCRIPT_UNIFIED'.ext.prefix = { "rsem.merged.transcript" }
process.'withName:.*:(QUANTIFY_BAM_SALMON|QUANTIFY_PSEUDO_ALIGNMENT):SALMON_QUANT'.ext.args = {
            def validLibTypes = [ 'A', 'U', 'SF', 'SR', 'IS', 'IU', 'ISF', 'ISR', 'OS', 'OU', 'OSF', 'OSR', 'MS', 'MU', 'MSF', 'MSR' ]
            def libType
            if (params.salmon_quant_libtype) {
                if (validLibTypes.contains(params.salmon_quant_libtype)) {
                    libType = params.salmon_quant_libtype
                }
                else {
                    log.info("[Salmon Quant] Invalid library type specified '--libType=${params.salmon_quant_libtype}', defaulting to auto-detection with '--libType=A'.")
                    libType = 'A'
                }
            }
            else {
                libType = meta.single_end
                    ? (meta.strandedness == 'forward' ? 'SF' : meta.strandedness == 'reverse' ? 'SR' : 'U')
                    : (meta.strandedness == 'forward' ? 'ISF' : meta.strandedness == 'reverse' ? 'ISR' : 'IU')
            }
            [ "--libType=${libType}", params.extra_salmon_quant_args ?: '' ].join(' ').trim()
        }
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:(CUSTOM_TX2GENE|TXIMETA_TXIMPORT)'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" }, mode:'copy', saveAs:{ filename ->
                if (filename.equals('versions.yml')) return null
                if (params.skip_quantification_merge && filename.endsWith('gene_counts_length_scaled.tsv')) return null
                filename
            }]
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:TXIMETA_TXIMPORT'.ext.prefix = { meta.id == 'all_samples' ? "${quant_type}.merged" : meta.id }
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_.*'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" }, mode:'copy', saveAs:{ filename -> filename.equals('versions.yml') || filename.endsWith('.log') ? null : filename }]
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_GENE_UNIFIED'.ext.prefix = { "${params.pseudo_aligner}.merged.gene" }
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_TRANSCRIPT_UNIFIED'.ext.prefix = { "${params.pseudo_aligner}.merged.transcript" }
process.'withName:DESEQ2_QC_PSEUDO'.ext.args = { [
            "--id_col 1",
            "--sample_suffix ''",
            "--count_col 3",
            params.deseq2_vst ? '--vst TRUE' : ''
        ].join(' ').trim() }
process.'withName:DESEQ2_QC_PSEUDO'.ext.args2 = { params.pseudo_aligner }
process.'withName:DESEQ2_QC_PSEUDO'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}/deseq2_qc" }, mode:'copy', pattern:'*{RData,pca.vals.txt,plots.pdf,sample.dists.txt,size_factors,log}']
apptainer.registry = 'quay.io'
apptainer.enabled = false
docker.registry = 'quay.io'
docker.enabled = true
docker.runOptions = '-u $(id -u):$(id -g)'
podman.registry = 'quay.io'
podman.enabled = false
singularity.registry = 'quay.io'
singularity.enabled = false
charliecloud.registry = 'quay.io'
charliecloud.enabled = false
