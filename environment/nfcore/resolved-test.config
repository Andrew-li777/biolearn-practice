process.'withName:.*:FASTQ_SUBSAMPLE_FQ_SALMON:FQ_SUBSAMPLE'.ext.prefix = { "${meta.id}.subsampled" }
process.'withName:.*:FASTQ_SUBSAMPLE_FQ_SALMON:FQ_SUBSAMPLE'.publishDir = [enabled:false]
process.'withName:.*:FASTQ_SUBSAMPLE_FQ_SALMON:SALMON_QUANT'.ext.args = '--skipQuant'
process.'withName:.*:FASTQ_SUBSAMPLE_FQ_SALMON:SALMON_QUANT'.publishDir = [enabled:false]
process.'withName:BBMAP_BBSPLIT'.ext.args = 'build=1 ambiguous2=all maxindel=150000 ow=f'
process.'withName:BBMAP_BBSPLIT'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}bbsplit" }, mode:'copy', pattern:'*.txt'], [path:{ params.save_bbsplit_reads ? "${params.outdir}/${task.ext.publish_prefix}bbsplit" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_bbsplit_reads ? filename : null }]]
process.'withName:SORTMERNA'.ext.args = '--num_alignments 1 -v --index 0'
process.'withName:SORTMERNA'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}sortmerna" }, mode:'copy', pattern:'*.log'], [path:{ params.save_non_ribo_reads ? "${params.outdir}/${task.ext.publish_prefix}sortmerna" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_non_ribo_reads ? filename : null }]]
process.'withName:.*ALIGN_STAR:STAR_ALIGN|.*ALIGN_STAR:SENTIEON_STAR_ALIGN|.*ALIGN_STAR:PARABRICKS_RNA_FQ2BAM'.ext.args = {
            def isPbrun = task.process.contains('PARABRICKS')
            def isSentieon = task.process.endsWith(':SENTIEON_STAR_ALIGN')
            def quantifier = params.aligner == 'star_rsem' ? 'rsem' : 'salmon'

            def args = []

            // Common args - pbrun uses kebab-case equivalents
            if (isPbrun) {
                args += [
                    '--quantMode TranscriptomeSAM',
                    '--out-sam-attributes NH HI AS NM MD',
                    '--read-files-command zcat',
                    "--read-group-sm ${task.tag}",
                    "--read-group-id-prefix ${task.tag}"
                ]
            } else {
                args += [
                    '--quantMode TranscriptomeSAM',
                    '--outSAMtype BAM Unsorted',
                    '--outSAMattributes NH HI AS NM MD',
                    '--readFilesCommand zcat'
                ]
            }

            // Quantifier-specific args
            //
            // NOTE: pbrun rna_fq2bam is based on STAR 2.7.2a and does NOT support:
            //   --outFilterType BySJout  : no pbrun equivalent; pbrun uses its own filtering defaults
            //   --sjdbScore 1            : no pbrun equivalent; affects junction scoring priority
            //   --quantTranscriptomeBan Singleend / --quantTranscriptomeSAMoutput BanSingleEnd :
            //       no pbrun equivalent; Salmon handles mixed single/paired records gracefully
            //   --runRNGseed 0           : no pbrun equivalent; pbrun uses deterministic alignment selection
            //
            if (quantifier == 'rsem') {
                if (isPbrun) {
                    args += [
                        '--out-sam-unmapped Within',
                        '--max-out-filter-multimap 20',
                        '--max-out-filter-mismatch 999',
                        '--max-out-filter-mismatch-ratio 0.04',
                        '--min-intron-size 20',
                        '--max-intron-size 1000000',
                        '--max-align-mates-gap 1000000',
                        '--min-align-sj-overhang 8',
                        '--min-align-sjdb-overhang 1'
                    ]
                } else {
                    args += [
                        '--outSAMunmapped Within',
                        '--outFilterType BySJout',
                        '--outFilterMultimapNmax 20',
                        '--outFilterMismatchNmax 999',
                        '--outFilterMismatchNoverLmax 0.04',
                        '--alignIntronMin 20',
                        '--alignIntronMax 1000000',
                        '--alignMatesGapMax 1000000',
                        '--alignSJoverhangMin 8',
                        '--alignSJDBoverhangMin 1',
                        '--sjdbScore 1'
                    ]
                }
            } else {
                if (isPbrun) {
                    args += [
                        '--two-pass-mode Basic',
                        '--max-out-filter-multimap 20',
                        '--min-align-sjdb-overhang 1',
                        '--out-sam-strand-field intronMotif'
                    ]
                } else {
                    args += [
                        '--twopassMode Basic',
                        '--runRNGseed 0',
                        '--outFilterMultimapNmax 20',
                        '--alignSJDBoverhangMin 1',
                        '--outSAMstrandField intronMotif',
                        // Sentieon's STAR build predates 2.7.7a so it still expects the
                        // pre-2.7.7a --quantTranscriptomeBan Singleend spelling. Drop this
                        // branch (and isSentieon) once Sentieon's bundled STAR is >= 2.7.7a.
                        isSentieon ? '--quantTranscriptomeBan Singleend' : '--quantTranscriptomeSAMoutput BanSingleEnd'
                    ]
                }
            }

            // Unmapped reads output
            if (params.save_unaligned || (params.contaminant_screening && params.contaminant_screening_input == 'unmapped')) {
                args += isPbrun
                    ? ['--out-reads-unmapped Fastx']
                    : ['--outReadsUnmapped Fastx']
            }

            // Prokaryotic: disable spliced alignment
            if (params.prokaryotic) {
                if (isPbrun) {
                    args += ['--max-intron-size 1']
                } else {
                    args += ['--sjdbGTFfeatureExon CDS', '--alignIntronMax 1']
                }
            }

            // Merge user-supplied extra args, deduplicating so user values
            // override pipeline defaults (prevents STAR "duplicate parameter" error)
            if (params.extra_star_align_args) {
                args = (args.join(' ') + ' ' + params.extra_star_align_args)
                    .split(/\s(?=--)/)
                    .collectEntries { String token ->
                        def parts = token.trim().split(/\s+/, 2)
                        [(parts[0]): parts.size() > 1 ? parts[1] : '']
                    }
                    .collect { k, v -> v ? "${k} ${v}" : k }
            }

            // Read group tags - assembled once from samplesheet meta and pipeline params
            // Per-sample meta values take priority over global params
            def seqCenter   = meta.seq_center   ?: params.seq_center
            def seqPlatform = meta.seq_platform ?: params.seq_platform
            if (isPbrun) {
                // pbrun supports --read-group-pl but has no --read-group-cn flag
                if (seqPlatform) args << "--read-group-pl ${seqPlatform}"
            } else {
                def rgParts = ["'ID:${meta.id}'", "'SM:${meta.id}'"]
                if (seqPlatform) rgParts << "'PL:${seqPlatform}'"
                if (seqCenter) rgParts << "'CN:${seqCenter}'"
                args += ["--outSAMattrRGline ${rgParts.join(' ')}"]
            }

            args.join(' ')
        }
process.'withName:.*ALIGN_STAR:STAR_ALIGN|.*ALIGN_STAR:SENTIEON_STAR_ALIGN|.*ALIGN_STAR:PARABRICKS_RNA_FQ2BAM'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/log" }, mode:'copy', pattern:'*.{out,tab}'], [path:{ params.save_align_intermeds ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" : params.outdir }, mode:'copy', pattern:'*.bam', saveAs:{ filename -> params.save_align_intermeds ? filename : null }], [path:{ params.save_unaligned ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/unmapped" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_unaligned ? filename : null }]]
process.'withName:.*:ALIGN_BOWTIE2:BOWTIE2_ALIGN'.ext.args = {
            def args = [
                '--very-sensitive',
                '--no-discordant',
                '-k 200'
            ]

            // Merge extras so user values override defaults (e.g. `-k N`).
            // Must run before RG args since `--rg` repeats and would collapse.
            if (params.extra_bowtie2_align_args) {
                args = (args.join(' ') + ' ' + params.extra_bowtie2_align_args)
                    .split(/\s(?=-)/)
                    .collectEntries { String token ->
                        def parts = token.trim().split(/\s+/, 2)
                        [(parts[0]): parts.size() > 1 ? parts[1] : '']
                    }
                    .collect { k, v -> v ? "${k} ${v}" : k }
            }

            // Read group tags - assembled once from samplesheet meta and pipeline params
            // Per-sample meta values take priority over global params
            def seqCenter   = meta.seq_center   ?: params.seq_center
            def seqPlatform = meta.seq_platform ?: params.seq_platform
            def rgParts = ["--rg-id ${meta.id}", "--rg SM:${meta.id}"]
            if (seqPlatform) rgParts << "--rg PL:${seqPlatform}"
            if (seqCenter) rgParts << "--rg CN:${seqCenter}"
            args += rgParts

            args.join(' ')
        }
process.'withName:.*:ALIGN_BOWTIE2:BOWTIE2_ALIGN'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/log" }, mode:'copy', pattern:'*.log'], [path:{ params.save_align_intermeds ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" : params.outdir }, mode:'copy', pattern:'*.bam', saveAs:{ filename -> params.save_align_intermeds ? filename : null }], [path:{ params.save_unaligned ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/unmapped" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_unaligned ? filename : null }]]
process.'withName:.*:FASTQ_ALIGN_HISAT2:HISAT2_ALIGN'.ext.args = {
            def argsList = ['--met-stderr', '--new-summary', '--dta']

            // Strandedness
            if (meta.strandedness == 'forward') {
                argsList << (meta.single_end ? '--rna-strandness F' : '--rna-strandness FR')
            } else if (meta.strandedness == 'reverse') {
                argsList << (meta.single_end ? '--rna-strandness R' : '--rna-strandness RF')
            }

            // Merge extras so user values override defaults (last occurrence of a flag wins).
            // Must run before RG args since `--rg` repeats and would collapse.
            if (params.extra_hisat2_align_args) {
                argsList = (argsList.join(' ') + ' ' + params.extra_hisat2_align_args)
                    .split(/\s(?=--)/)
                    .collectEntries { String token ->
                        def parts = token.trim().split(/\s+/, 2)
                        [(parts[0]): parts.size() > 1 ? parts[1] : '']
                    }
                    .collect { k, v -> v ? "${k} ${v}" : k }
            }

            // Read group tags - assembled once from samplesheet meta and pipeline params
            // Per-sample meta values take priority over global params
            def seqCenter   = meta.seq_center   ?: params.seq_center
            def seqPlatform = meta.seq_platform ?: params.seq_platform
            argsList << "--rg-id ${meta.id}"
            argsList << "--rg SM:${meta.id}"
            if (seqPlatform) argsList << "--rg PL:${seqPlatform}"
            if (seqCenter) argsList << "--rg CN:${seqCenter}"

            argsList.join(' ')
        }
process.'withName:.*:FASTQ_ALIGN_HISAT2:HISAT2_ALIGN'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/log" }, mode:'copy', pattern:'*.log'], [path:{ params.save_align_intermeds ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" : params.outdir }, mode:'copy', pattern:'*.bam', saveAs:{ filename -> params.save_align_intermeds ? filename : null }], [path:{ params.save_unaligned ? "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/unmapped" : params.outdir }, mode:'copy', pattern:'*.fastq.gz', saveAs:{ filename -> params.save_unaligned ? filename : null }]]
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:PICARD_MARKDUPLICATES'.ext.args = '--ASSUME_SORTED true --REMOVE_DUPLICATES false --VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:PICARD_MARKDUPLICATES'.ext.prefix = { "${meta.id}.markdup.sorted" }
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:PICARD_MARKDUPLICATES'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/picard_metrics" }, mode:'copy', pattern:'*metrics.txt'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" }, mode:'copy', pattern:'*.bam']]
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:SAMTOOLS_INDEX'.ext.args = { params.bam_csi_index ? '-c' : '' }
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:SAMTOOLS_INDEX'.ext.prefix = { "${meta.id}.markdup.sorted" }
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:SAMTOOLS_INDEX'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" }, mode:'copy', pattern:'*.{bai,csi}']
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:BAM_STATS_SAMTOOLS:.*'.ext.when = { !params.use_rustqc }
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:BAM_STATS_SAMTOOLS:.*'.ext.prefix = { "${meta.id}.markdup.sorted.bam" }
process.'withName:.*:BAM_MARKDUPLICATES_PICARD:BAM_STATS_SAMTOOLS:.*'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/samtools_stats" }, mode:'copy', pattern:'*.{stats,flagstat,idxstats}']
process.'withName:.*:QUANTIFY_RSEM:RSEM_CALCULATEEXPRESSION|.*:QUANTIFY_RSEM:SENTIEON_RSEMCALCULATEEXPRESSION'.ext.args = '--estimate-rspd --seed 1'
process.'withName:.*:QUANTIFY_RSEM:RSEM_CALCULATEEXPRESSION|.*:QUANTIFY_RSEM:SENTIEON_RSEMCALCULATEEXPRESSION'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}" }, mode:'copy', pattern:'*.{stat,results}'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/log" }, mode:'copy', pattern:'*.log']]
process.'withName:.*:QUANTIFY_RSEM:CUSTOM_RSEMMERGECOUNTS'.ext.prefix = { "rsem.merged" }
process.'withName:.*:QUANTIFY_RSEM:CUSTOM_RSEMMERGECOUNTS'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rsem_merge_counts" }, mode:'copy']
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:SALMON_QUANT'.ext.args = { params.extra_salmon_quant_args ?: '' }
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:SALMON_QUANT'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" }, mode:'copy', saveAs:{ filename -> filename.endsWith('_meta_info.json') || filename.endsWith('_format_counts.json') ? null : filename }]
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:KALLISTO_QUANT'.ext.args = {
            def extra = params.extra_kallisto_quant_args ?: ''
            def strandedness = (extra.contains('--fr-stranded') || extra.contains('--rf-stranded')) ? '' :
                meta.strandedness == 'forward' ? '--fr-stranded' :
                meta.strandedness == 'reverse' ? '--rf-stranded' : ''
            [ strandedness, extra ].join(' ').trim()
        }
process.'withName:.*:QUANTIFY_PSEUDO_ALIGNMENT:KALLISTO_QUANT'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.pseudo_aligner}" }, mode:'copy', saveAs:{ filename -> filename.endsWith('.run_info.json') || filename.endsWith('.log') ? null : filename }]
process.'withName:.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:CUSTOM_TX2GENE'.ext.prefix = { "${quant_type}.merged" }
process.'withName:.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:TXIMETA_TXIMPORT'.ext.prefix = { "${quant_type}.merged" }
process.'withName:.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_GENE_UNIFIED'.ext.prefix = { "${meta.id}_gene" }
process.'withName:.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_GENE_UNIFIED'.ext.args = '--assay_names counts,counts_length_scaled,counts_scaled,lengths,tpm'
process.'withName:.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_TRANSCRIPT_UNIFIED'.ext.prefix = { "${meta.id}_transcript" }
process.'withName:.*:QUANT_TXIMPORT_SUMMARIZEDEXPERIMENT:SE_TRANSCRIPT_UNIFIED'.ext.args = '--assay_names counts,lengths,tpm'
process.'withName:SUBREAD_FEATURECOUNTS'.ext.args = { [
            '-B -C',
            params.gencode ? "-g gene_type" : "-g $params.featurecounts_group_type",
            "-t $params.featurecounts_feature_type"
        ].join(' ').trim() }
process.'withName:SUBREAD_FEATURECOUNTS'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/featurecounts" }, mode:'copy']
process.'withName:CUSTOM_MULTIQCCUSTOMBIOTYPE'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/featurecounts" }, mode:'copy', saveAs:{ filename -> filename.equals('versions.yml') ? null : filename }]
process.'withName:STRINGTIE_STRINGTIE'.ext.args = {
            def strandedness = meta.strandedness == 'forward' ? '--fr' :
                meta.strandedness == 'reverse' ? '--rf' : ''
            [ strandedness, '-v' ].join(' ').trim()
        }
process.'withName:STRINGTIE_STRINGTIE'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/stringtie" }, mode:'copy']
process.'withName:NFCORE_RNASEQ:RNASEQ:BAM_STRINGTIE_MERGE:STRINGTIE_STRINGTIE'.ext.prefix = { "${meta.id}.denovo" }
process.'withName:NFCORE_RNASEQ:RNASEQ:BAM_STRINGTIE_MERGE:STRINGTIE_STRINGTIE'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/stringtie" }, mode:'copy', saveAs:{ filename ->
                if (filename.endsWith('.transcripts.gtf')) return filename
                return null
            }]
process.'withName:NFCORE_RNASEQ:RNASEQ:BAM_STRINGTIE_MERGE:STRINGTIE_MERGE'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/stringtie" }, mode:'copy']
process.'withName:.*:BAM_RSEQC:RSEQC_BAMSTAT'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/bam_stat" }, mode:'copy']
process.'withName:.*:BAM_RSEQC:RSEQC_INFEREXPERIMENT'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/infer_experiment" }, mode:'copy']
process.'withName:.*:BAM_RSEQC:RSEQC_JUNCTIONANNOTATION'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/junction_annotation/pdf" }, mode:'copy', pattern:'*.pdf'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/junction_annotation/bed" }, mode:'copy', pattern:'*.bed'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/junction_annotation/xls" }, mode:'copy', pattern:'*.xls'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/junction_annotation/log" }, mode:'copy', pattern:'*.log'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/junction_annotation/rscript" }, mode:'copy', pattern:'*.r']]
process.'withName:.*:BAM_RSEQC:RSEQC_JUNCTIONSATURATION'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/junction_saturation/pdf" }, mode:'copy', pattern:'*.pdf'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/junction_saturation/rscript" }, mode:'copy', pattern:'*.r']]
process.'withName:.*:BAM_RSEQC:RSEQC_READDUPLICATION'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/read_duplication/pdf" }, mode:'copy', pattern:'*.pdf'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/read_duplication/xls" }, mode:'copy', pattern:'*.xls'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/read_duplication/rscript" }, mode:'copy', pattern:'*.r']]
process.'withName:.*:BAM_RSEQC:RSEQC_READDISTRIBUTION'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/read_distribution" }, mode:'copy']
process.'withName:.*:BAM_RSEQC:RSEQC_INNERDISTANCE'.publishDir = [[path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/inner_distance/txt" }, mode:'copy', pattern:'*.txt'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/inner_distance/pdf" }, mode:'copy', pattern:'*.pdf'], [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/inner_distance/rscript" }, mode:'copy', pattern:'*.r']]
process.'withName:.*:BAM_RSEQC:RSEQC_TIN'.publishDir = [path:{ "${params.outdir}/${task.ext.publish_prefix}${params.aligner}/rseqc/tin" }, mode:'copy']
